{
  "name": "ekos-edms",
  "version": "0.0.0-faz0a",
  "private": true,
  "description": "EKOS Enterprise Document & Contract Management (EKOS EDMS)",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "typecheck": "pnpm typecheck:root && pnpm -r --filter \"!ekos-edms\" --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "e2e": "playwright test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "typecheck:root": "tsc -p tsconfig.json",
    "db:validate": "pnpm --filter @ekos/db prisma:validate",
    "db:migrate": "pnpm --filter @ekos/db exec prisma migrate deploy",
    "db:generate": "pnpm --filter @ekos/db prisma:generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "tsx": "4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^4.1.11",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "effect": ">=3.20.0 <4.0.0",
      "deepmerge-ts": ">=8.0.0 <9.0.0",
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0"
    }
  }
}
