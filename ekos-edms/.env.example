# EKOS EDMS — ortam değişkenleri ŞABLONU (Faz 7).
# Bu dosyaya GERÇEK DEĞER YAZMAYIN. Gerçek değerler secret manager'dan veya sunucudaki ortamdan okunur.
# Anahtar listesi kodla eşleşir: packages/core/src/config/env-example.test.ts bu dosyayı kod ile karşılaştırır.
# Üretimde zorunlu olan anahtarlar eksik ya da geçersizse uygulama BAŞLAMAZ (packages/core/src/config/runtime-config.ts).

# --- Çalışma modu ---
NODE_ENV=production
# Kimlik doğrulama modu: "local" (yerel parola + TOTP) veya "oidc" (Microsoft Entra ID). Varsayılan YOKTUR.
AUTH_MODE=

# --- Veritabanı (PostgreSQL) ---
# Uygulama rolü; yalnız gerekli yetkilere sahip olmalı (audit tablosu INSERT-only, ADR-0007).
DATABASE_URL=

# --- Nesne deposu (yerel dosya sistemi; mutlak yol, uygulama dışından erişilemez) ---
STORAGE_ROOT=

# --- TOTP sır şifreleme anahtarı (AUTH_MODE=local). 32 bayt rastgele değer, base64. ---
TOTP_ENCRYPTION_KEY=

# --- Microsoft Entra ID / OIDC (AUTH_MODE=oidc) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Üretimde https olmalı.
ENTRA_REDIRECT_URI=

# --- Antivirüs (ClamAV clamd). Yoksa yüklenen dosyalar taranamaz ve kullanılamaz. ---
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=60000

# --- OCR ---
TESSERACT_BIN=

# --- E-imza sağlayıcı (üçü birlikte ya da hiçbiri). Base URL https olmalı. ---
ESIGN_API_BASE_URL=
ESIGN_API_TOKEN=
ESIGN_WEBHOOK_SECRET=
ESIGN_TIMEOUT_MS=30000

# --- Yapay zekâ (varsayılan KAPALI). Açmak için AI_DATA_PROCESSING_APPROVED=true ve onaylı belge türleri gerekir. ---
AI_PROVIDER=
AI_MODEL=
AI_DATA_PROCESSING_APPROVED=false
# Virgülle ayrılmış belge türü kodları (ör. SOZLESME). Boşsa dış AI'ya hiçbir belge gönderilmez.
AI_APPROVED_DOCUMENT_TYPES=
GEMINI_API_KEY=
VERTEX_PROJECT=
VERTEX_LOCATION=
VERTEX_ACCESS_TOKEN=

# --- Zamanlanmış işler ve işçi ---
JOBS_ACTOR_EMAIL=
JOBS_INTERVAL_SECONDS=300
WORKER_POLL_MS=2000

# --- Yapılandırılabilir limitler ---
MAX_UPLOAD_MB=50
MAX_MANIFEST_MB=5
SEARCH_PAGE_MAX=100

# --- Yalnız geliştirme / test. ÜRETİMDE TANIMLANMAZ (tanımlanırsa uygulama başlamaz). ---
# EKOS_DEV_PASSWORD=

# --- Yönetim betikleri (komut satırı girdileri; çalıştırma anında verilir, kalıcı tutulmaz) ---
# EKOS_EMAIL=            # scripts/reset-totp.ts, create-user.ts
# EKOS_MATRIX_FILE=      # scripts/publish-approval-matrix.ts
# EKOS_ORGANIZATION_WIDE=  # onay matrisi kurum geneli kapsam bayrağı
